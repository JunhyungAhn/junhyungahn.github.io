@inproceedings{ahn2025postclick,
  abbr        = {ICDM},
  bibtex_show = {true},
  selected    = {true},
  title       = {On Predicting Post-Click Conversion Rate via Counterfactual Inference},
  author      = {Ahn, Junhyung and Lee, Sanghack},
  booktitle   = {IEEE International Conference on Data Mining (ICDM)},
  pages       = {11--20},
  year        = {2025},
  award       = {**Best Paper Award Finalist**, IEEE ICDM 2025},
  award_name  = {Best Paper Finalist},
  abstract    = {Conversion rate prediction suffers from selection bias: conversion labels are observed only for clicked impressions. We cast the missing labels as a counterfactual quantity and impute conversions for non-clicked samples via counterfactual inference, improving both offline estimation and online conversion rate.}
}

